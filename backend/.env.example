[TEMPLATE]
# Copy this file to .env and fill in real values before running the backend.
# Never commit the real .env file.

ENV=development

# A long, random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRY_MINUTES=60

# LLM API (OpenAI-compatible) — Groq free tier recommended
# Get your key at https://console.groq.com (no credit card required)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Leave as default for local SQLite; set to a Postgres URL in production
DATABASE_URL=sqlite:///./app.db
