# ============================================
# Backend Environment Variables for Render
# ============================================
# Copy these into Render's Environment tab.
# All values are required.

# --- Database ---
# For Render PostgreSQL (recommended):
DATABASE_URL=postgresql://user:password@host:5432/dbname
# For local SQLite (fallback):
# DATABASE_URL=sqlite:///./app.db

# --- Auth / JWT ---
# Generate a strong random string (64+ chars). Example:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_64_char_random_hex_string_here

# --- LLM API (Groq — free, no credit card) ---
# Get one at: https://console.groq.com
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# --- OCR API (OCR.space — free, no credit card) ---
# Get one at: https://ocr.space/ocrapi/freekey
OCR_API_KEY=your_ocr_space_api_key_here

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# For Vercel deployment, use your Vercel URL:
ALLOWED_ORIGINS=https://your-app.vercel.app
# For local dev:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
