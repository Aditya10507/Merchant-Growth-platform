# ============================================
# Backend Environment Variables for Render
# ============================================
# Copy these into Render's Environment tab.
# All values are required.

# --- Database ---
# For Render PostgreSQL (recommended):
DATABASE_URL=postgresql://user:password@host:5432/dbname
# For local SQLite (fallback):
# DATABASE_URL=sqlite:///./app.db

# --- Auth / JWT ---
# Generate a strong random string (64+ chars). Example:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_64_char_random_hex_string_here

# --- LLM API (Groq — free, no credit card) ---
# ONE key powers both document extraction (vision OCR) and LLM
# cross-verification. Get one at: https://console.groq.com
# IMPORTANT: the account must have the vision model enabled under
# Project settings → Limits (console.groq.com/settings/project/limits).
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Must be a Groq VISION-capable model — qwen/qwen3.8-27b (default) or
# qwen/qwen3.6-27b. gpt-oss models are text-only on Groq and cannot
# extract from document images.
LLM_MODEL=qwen/qwen3.8-27b
# Optional: comma-separated Groq keys from OTHER accounts. Rotated to on
# 401/403/429 for extra free-tier headroom. Keys on one account add nothing.
# LLM_FALLBACK_KEYS=gsk_key2,gsk_key3

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# For Vercel deployment, use your Vercel URL:
ALLOWED_ORIGINS=https://your-app.vercel.app
# For local dev:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
